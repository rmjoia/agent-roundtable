#!/usr/bin/env bash
# agent-roundtable:generated template=pre-commit version=0.1.0
#
# Every commit is green. This hook is the safety net, not the check: agents run
# these gates themselves before committing. A failure here means a gate was skipped.
# Never bypass it with --no-verify.
#
# Gates come from team.config.yaml → gates.pre_commit. Change them there and
# re-run /init-team, or edit the GATES block below (owned by the devops role).

set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
STAGED="$(git diff --cached --name-only --diff-filter=ACMRD)"
[ -z "$STAGED" ] && exit 0


red() { printf '\033[0;31m%s\033[0m\n' "$*"; }
green() { printf '\033[0;32m%s\033[0m\n' "$*"; }
yellow() { printf '\033[1;33m%s\033[0m\n' "$*"; }

FAILED=0
LOG_DIR="$(mktemp -d)"
trap 'rm -rf "$LOG_DIR"' EXIT

# Secrets and identifiers in the staged content. Patterns are deliberately
# conservative; add private ones (product, domain, people's names) to the git-ignored
# .scrub-patterns.local, one extended regex per line.
SCAN_PATTERNS='-----BEGIN [A-Z ]*PRIVATE KEY-----|AKIA[0-9A-Z]{16}|ghp_[A-Za-z0-9]{36}|gho_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{50,}|xox[baprs]-[A-Za-z0-9-]{10,}|sk-[A-Za-z0-9]{32,}|AccountKey=[A-Za-z0-9+/=]{20,}'
if [ -f "$REPO_ROOT/.scrub-patterns.local" ]; then
  EXTRA="$(grep -v '^#' "$REPO_ROOT/.scrub-patterns.local" | grep -v '^$' | paste -sd '|' -)"
  [ -n "$EXTRA" ] && SCAN_PATTERNS="$SCAN_PATTERNS|$EXTRA"
fi
if git diff --cached -U0 | grep '^+' | grep -v '^+++' | grep -nE -- "$SCAN_PATTERNS" > "$LOG_DIR/scan.log"; then
  red "✗ Possible secret or identifier in staged changes:"
  cut -c1-120 "$LOG_DIR/scan.log"
  FAILED=1
else
  green "✓ No secrets or identifiers in staged changes"
fi

# gate <name> <extended regex on staged paths> <working dir> <command>
gate() {
  local name="$1" pattern="$2" cwd="$3" cmd="$4" log
  grep -qE -- "$pattern" <<< "$STAGED" || return 0
  yellow "▶ $name"
  log="$LOG_DIR/$(tr -c 'a-zA-Z0-9' '_' <<< "$name").log"
  if (cd "$REPO_ROOT/$cwd" && bash -c "$cmd") > "$log" 2>&1; then
    green "✓ $name"
  else
    red "✗ $name  (cd $cwd && $cmd)"
    tail -25 "$log"
    FAILED=1
  fi
}

# agent-roundtable:gates:start
gate "web: lint" "^web/" "web" "npm run lint"
gate "web: test" "^web/" "web" "npx vitest run"
gate "web: build" "^web/" "web" "npx tsc -b"
gate "api: lint" "^api/" "api" "npm run lint"
gate "api: test" "^api/" "api" "npx vitest run"
gate "api: build" "^api/" "api" "npm run build"
# agent-roundtable:gates:end

if [ "$FAILED" -ne 0 ]; then
  red "Commit blocked: fix the failures above and run the gates before committing."
  exit 1
fi
green "✓ All gates passed"
